# URL base del Cloudflare Worker (ver carpeta /worker) que crea el enlace de
# pago con Wompi y, tras la confirmación por webhook, envía el correo del
# pedido con la receta adjunta. Ejemplo: https://masvision-order-email.tu-subdominio.workers.dev
VITE_ORDER_API_BASE=

# Config pública de Firebase (Authentication > Configuración del proyecto >
# Tus apps > Web). No son secretos, son públicos por diseño.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
